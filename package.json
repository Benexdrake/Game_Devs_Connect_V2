{
  "name": "gamedevs-connect",
  "private": true,
  "scripts": {
    "frontend": "dotenv -e .env -- env BACKEND_URL=http://localhost:8080 npm run dev --prefix GameDevsConnect.Frontend",
    "backend": "docker compose up -d db api",
    "backend:down": "docker compose down",
    "backend:logs": "docker compose logs -f api",
    "dev": "bash scripts/dev.sh"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0"
  }
}
