# syntax=docker/dockerfile:1
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY GameDevsConnect.slnx ./
COPY GameDevsConnect.Api/GameDevsConnect.Api.csproj GameDevsConnect.Api/
RUN dotnet restore GameDevsConnect.Api/GameDevsConnect.Api.csproj

COPY GameDevsConnect.Api/. GameDevsConnect.Api/
RUN dotnet publish GameDevsConnect.Api/GameDevsConnect.Api.csproj -c Release -o /app/publish --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
# Npgsql loads libgssapi_krb5 for GSSAPI auth support even though we use password auth;
# without it Npgsql logs a harmless but noisy "cannot open shared object file" error.
RUN apt-get update && apt-get install -y --no-install-recommends libkrb5-3 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /app/publish .

EXPOSE 8080
ENV ASPNETCORE_URLS=http://+:8080
ENTRYPOINT ["dotnet", "GameDevsConnect.Api.dll"]
