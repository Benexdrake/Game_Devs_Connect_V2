# syntax=docker/dockerfile:1
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY GameDevsConnect.slnx ./
COPY src/GameDevsConnect.Api/GameDevsConnect.Api.csproj src/GameDevsConnect.Api/
RUN dotnet restore src/GameDevsConnect.Api/GameDevsConnect.Api.csproj

COPY src/GameDevsConnect.Api/. src/GameDevsConnect.Api/
RUN dotnet publish src/GameDevsConnect.Api/GameDevsConnect.Api.csproj -c Release -o /app/publish --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
COPY --from=build /app/publish .

EXPOSE 8080
ENV ASPNETCORE_URLS=http://+:8080
ENTRYPOINT ["dotnet", "GameDevsConnect.Api.dll"]
