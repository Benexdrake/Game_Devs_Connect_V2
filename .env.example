# Kopieren nach .env und mit echten Werten befuellen. .env selbst wird nicht committed.

# GitHub OAuth App (siehe Plan/Tasks/phase-0-projekt-fundament.md)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Muss exakt der in der GitHub OAuth App hinterlegten Callback-URL entsprechen
GITHUB_CALLBACK_URL=http://localhost:8080/api/auth/callback/github

# Wohin nach erfolgreichem Login redirected wird
FRONTEND_BASE_URL=http://localhost:3000

# Nur fuer den Caddy-Reverse-Proxy in Produktion (docker compose --profile proxy up -d)
DOMAIN=

# true (Default) fuer Produktion hinter Caddy/TLS. Auf false setzen fuer lokales
# docker compose ohne Reverse Proxy (reines HTTP), sonst schickt der Browser die
# Session-/OAuth-State-Cookies nicht zurueck und der Login schlaegt fehl.
COOKIES_REQUIRE_HTTPS=true

# true, um beim Start Dummy-Daten (5 User, je 3 Projekte, je 5 Quests) zu seeden.
# Wirkt nur, solange die DB noch keine Seed-Daten enthaelt (erkannt an einem
# GitHubId-Praefix) - laeuft also gefahrlos bei jedem Neustart mit.
SEED_ENABLED=false

# Impressum (§5 TMG) - wird nur serverseitig von der Impressum-Seite gelesen,
# landet nie im Client-Bundle. Telefonnummer ist optional (TMG verlangt keine,
# wenn eine schnelle elektronische Kontaktaufnahme wie E-Mail besteht).
IMPRESSUM_NAME=
IMPRESSUM_ADDRESS=
IMPRESSUM_EMAIL=

